<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-trust packaged app manifest for the Nexus Microsoft Store shell (see
  the "Microsoft Store (MSIX)" section in installer/README.md). Shape verified
  against the Microsoft-published sample manifest for a full-trust packaged
  Win32 app:
  https://github.com/Microsoft/DesktopBridgeToUWP-Samples/blob/master/Samples/HelloWorldSample/CentennialPackage/AppxManifest.xml
  cross-checked against the schema references for uap:VisualElements,
  uap:DefaultTile, and Properties/Logo on learn.microsoft.com/uwp/schemas.

  build-msix.ps1 substitutes the double-brace placeholders below (identity
  name, publisher, publisher display name, version, processor architecture)
  and writes the result into the packaging staging directory as
  AppxManifest.xml.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="{{ARCH}}" />

  <Properties>
    <!--
      Must stay a name reserved in Partner Center or the submission is rejected;
      "Nexus" belongs to another publisher. Neither this nor the VisualElements
      DisplayName below is substituted by build-msix.ps1.
    -->
    <DisplayName>Hello Nexus</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <!-- MaxVersionTested matches the Win10 TFM the rest of the service
       publishes against. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="NexusStoreLauncher" Executable="NexusStoreLauncher.exe" EntryPoint="Windows.FullTrustApplication">
      <!-- DisplayName: reserved Partner Center name, see Properties above. -->
      <uap:VisualElements
        DisplayName="Hello Nexus"
        Description="Nexus hardware monitoring, control, and RGB lighting."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
