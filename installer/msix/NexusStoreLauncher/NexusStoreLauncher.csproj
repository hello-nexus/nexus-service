<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Packaging glue for the Microsoft Store MSIX shell, not part of the service
    itself. Nexus.slnx references it so an ordinary solution build compiles it
    (nexus-service has no CI of its own; the umbrella's build.yml runs the same
    solution build); it is never published by the service build. installer/msix/build-msix.ps1 publishes it separately, RID selected
    by that script's -Rid parameter.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NexusStoreLauncher</RootNamespace>
    <AssemblyName>NexusStoreLauncher</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No console window; fatal errors go through MessageBoxW instead. -->
    <OutputType>WinExe</OutputType>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <!-- The LibraryImport source generator emits unsafe marshalling code for MessageBoxW. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
