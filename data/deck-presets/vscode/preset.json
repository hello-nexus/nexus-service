{
  "format": 1,
  "id": "vscode",
  "name": "Visual Studio Code",
  "author": "Nexus",
  "version": "1.0.0",
  "description": "Editor, terminal and run shortcuts for VS Code.",
  "match": {
    "processNames": [
      "code"
    ],
    "displayNames": [
      "Visual Studio Code",
      "Code"
    ]
  },
  "cols": 5,
  "rows": 3,
  "deck": {
    "pages": [
      {
        "slots": [
          {
            "icon": {
              "kind": "lucide",
              "value": "Command"
            },
            "label": "Commands",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+shift+p",
              "keysMac": "cmd+shift+p"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Search"
            },
            "label": "Quick Open",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+p",
              "keysMac": "cmd+p"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Terminal"
            },
            "label": "Terminal",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+`"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Layers"
            },
            "label": "Sidebar",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+b",
              "keysMac": "cmd+b"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Search"
            },
            "label": "Find in Files",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+shift+f",
              "keysMac": "cmd+shift+f"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Play"
            },
            "label": "Run",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "f5"
            },
            "color": "#1e8449"
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Power"
            },
            "label": "Stop",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "shift+f5"
            },
            "color": "#c0392b"
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "MessageSquare"
            },
            "label": "Comment",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+/",
              "keysMac": "cmd+/"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Sparkles"
            },
            "label": "Format",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "alt+shift+f"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Type"
            },
            "label": "Rename",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "f2"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Folder"
            },
            "label": "Explorer",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+shift+e",
              "keysMac": "cmd+shift+e"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Upload"
            },
            "label": "Source Control",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+shift+g"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Plus"
            },
            "label": "Extensions",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+shift+x",
              "keysMac": "cmd+shift+x"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Bell"
            },
            "label": "Problems",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+shift+m",
              "keysMac": "cmd+shift+m"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Settings"
            },
            "label": "Settings",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+,",
              "keysMac": "cmd+,"
            }
          }
        ]
      }
    ],
    "defaultTitleStyle": {
      "show": true,
      "align": "bottom",
      "size": 14,
      "bold": true
    }
  }
}
