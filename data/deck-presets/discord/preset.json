{
  "format": 1,
  "id": "discord",
  "name": "Discord",
  "author": "Nexus",
  "version": "1.0.0",
  "description": "Voice controls, channel navigation and inbox for Discord.",
  "match": {
    "processNames": [
      "discord"
    ],
    "displayNames": [
      "Discord"
    ]
  },
  "cols": 5,
  "rows": 3,
  "deck": {
    "pages": [
      {
        "slots": [
          {
            "icon": {
              "kind": "lucide",
              "value": "MicOff"
            },
            "label": "Mute",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+shift+m",
              "keysMac": "cmd+shift+m"
            },
            "color": "#c0392b"
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Headphones"
            },
            "label": "Deafen",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+shift+d",
              "keysMac": "cmd+shift+d"
            },
            "color": "#c0392b"
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Search"
            },
            "label": "Quick Switch",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+k",
              "keysMac": "cmd+k"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Sparkles"
            },
            "label": "Emoji",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+e",
              "keysMac": "cmd+e"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Upload"
            },
            "label": "Upload",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+shift+u",
              "keysMac": "cmd+shift+u"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "ArrowUp"
            },
            "label": "Prev Channel",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "alt+up"
            },
            "color": "#4a5568"
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "ArrowDown"
            },
            "label": "Next Channel",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "alt+down"
            },
            "color": "#4a5568"
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "ChevronLeft"
            },
            "label": "Prev Server",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+alt+up",
              "keysMac": "cmd+alt+up"
            },
            "color": "#4a5568"
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "ChevronRight"
            },
            "label": "Next Server",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+alt+down",
              "keysMac": "cmd+alt+down"
            },
            "color": "#4a5568"
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Undo2"
            },
            "label": "Back",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "alt+left",
              "keysMac": "cmd+["
            },
            "color": "#4a5568"
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Eye"
            },
            "label": "Mark Read",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "escape"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Eye"
            },
            "label": "Server Read",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "shift+escape"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Star"
            },
            "label": "Pins",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+p",
              "keysMac": "cmd+p"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Mail"
            },
            "label": "Inbox",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+i",
              "keysMac": "cmd+i"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Settings"
            },
            "label": "Settings",
            "title": {
              "show": true,
              "align": "bottom",
              "size": 14,
              "bold": true
            },
            "action": {
              "type": "hotkey",
              "keys": "ctrl+,",
              "keysMac": "cmd+,"
            }
          }
        ]
      }
    ],
    "defaultTitleStyle": {
      "show": true,
      "align": "bottom",
      "size": 14,
      "bold": true
    }
  }
}
