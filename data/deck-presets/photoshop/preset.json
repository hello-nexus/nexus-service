{
  "format": 1,
  "id": "photoshop",
  "name": "Adobe Photoshop",
  "author": "Nexus",
  "version": "1.0.0",
  "description": "Tools, layers and adjustments for Photoshop.",
  "match": {
    "processNames": [
      "photoshop"
    ],
    "displayNames": [
      "Adobe Photoshop"
    ]
  },
  "cols": 5,
