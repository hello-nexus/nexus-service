          {
            "icon": {
              "kind": "lucide",
              "value": "Sliders"
            },
            "label": "Levels",
            "action": {
              "type": "hotkey",
              "keys": "ctrl+l"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Activity"
            },
            "label": "Curves",
            "action": {
              "type": "hotkey",
              "keys": "ctrl+m"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Palette"
            },
            "label": "Hue / Sat",
            "action": {
              "type": "hotkey",
              "keys": "ctrl+u"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Layers"
            },
            "label": "Merge Down",
            "action": {
              "type": "hotkey",
              "keys": "ctrl+e"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "RefreshCw"
            },
            "label": "Invert Sel",
            "action": {
              "type": "hotkey",
              "keys": "ctrl+shift+i"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Upload"
            },
            "label": "Export",
            "action": {
              "type": "hotkey",
              "keys": "ctrl+alt+shift+w"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Copy"
            },
            "label": "Select All",
            "action": {
              "type": "hotkey",
              "keys": "ctrl+a"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Flame"
            },
            "label": "Fill",
            "action": {
              "type": "hotkey",
              "keys": "shift+f5"
            }
