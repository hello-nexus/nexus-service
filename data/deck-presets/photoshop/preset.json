          {
            "icon": {
              "kind": "lucide",
              "value": "Eye"
            },
            "label": "Deselect",
            "action": {
              "type": "hotkey",
              "keys": "ctrl+d"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Save"
            },
