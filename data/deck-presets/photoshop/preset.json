            },
            "label": "Move",
            "action": {
              "type": "hotkey",
              "keys": "v"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Copy"
            },
            "label": "Marquee",
            "action": {
              "type": "hotkey",
              "keys": "m"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Sparkles"
            },
            "label": "Lasso",
            "action": {
              "type": "hotkey",
              "keys": "l"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Palette"
            },
            "label": "Brush",
            "action": {
              "type": "hotkey",
              "keys": "b"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Trash2"
            },
            "label": "Eraser",
            "action": {
              "type": "hotkey",
              "keys": "e"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Type"
            },
            "label": "Type",
            "action": {
              "type": "hotkey",
              "keys": "t"
            }
          },
          {
            "icon": {
              "kind": "lucide",
              "value": "Image"
            },
            "label": "Crop",
            "action": {
              "type": "hotkey",
              "keys": "c"
