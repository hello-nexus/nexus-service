{
  "_comment": "Canonical install-time defaults for Nexus. Edit here, not in C# class initializers or TS modules. The nexus-service Defaults loader reads this on startup; NexusSettings + FanProfiles + PanelLayoutDefaults pull their literals from it. The nexus-web debug-tools export menu serializes the running config in the same shape so paste-it-back-to-the-AI round-trips cleanly. Schema is camelCase; add new fields by domain.",

  "theme": {
    "language": "en",
    "themeMode": "system",
    "accentColor": "#2563eb"
  },

  "monitoring": {
    "showAverage": true,
    "showMacStatusBarIcon": true,
    "showWindowsTrayIcon": true
  },

  "panel": {
    "autoLaunch": true,
    "themeSyncWithDesktop": true,
    "themeMode": "system",
    "accentSyncWithDesktop": true,
    "backgroundMode": "solid",
    "backgroundEffect": "aurora",
    "backgroundTemplate": 0,
    "backgroundOpacity": 0.4,
    "widgetOpacity": 0.5,
    "widgetLabels": false,
    "widgetBlur": false,
    "layouts": {
      "desktop": {
        "layoutSchemaVersion": 2,
        "surface": "desktop",
        "widgets": [
          {
            "type": "monitoring",
            "size": "4x2",
            "col": 0,
            "row": 0,
            "config": {
              "slotCount": 2,
              "slot0_device": "quick",
              "slot0_sensor": "summary/cpu-usage",
              "slot0_design": "sparkline",
              "slot1_device": "quick",
              "slot1_sensor": "summary/memory-usage",
              "slot1_design": "halfgauge"
            }
          },
          {
            "type": "diagnostics",
            "size": "2x2",
            "col": 4,
            "row": 0
          },
          {
            "type": "lighting",
            "size": "4x2",
            "col": 0,
            "row": 2
          },
          {
            "type": "weather",
            "size": "2x2",
            "col": 4,
            "row": 2
          },
          {
            "type": "cooling",
            "size": "4x2",
            "col": 0,
            "row": 4
          }
        ]
      },
      "y70": {
        "layoutSchemaVersion": 2,
        "surface": "y70",
        "widgets": [
          {
            "type": "clock",
            "size": "4x2",
            "col": 0,
            "row": 0
          },
          {
            "type": "monitoring",
            "size": "4x2",
            "col": 0,
            "row": 2,
            "config": {
              "slotCount": 2,
              "slot0_device": "quick",
              "slot0_sensor": "summary/cpu-usage",
              "slot0_design": "sparkline",
              "slot1_device": "quick",
              "slot1_sensor": "summary/memory-usage",
              "slot1_design": "halfgauge"
            }
          },
          {
            "type": "lighting",
            "size": "4x2",
            "col": 0,
            "row": 4
          },
          {
            "type": "cooling",
            "size": "4x2",
            "col": 0,
            "row": 6
          }
        ]
      },
      "phone": {
        "layoutSchemaVersion": 2,
        "surface": "phone",
        "widgets": [
          {
            "type": "monitoring",
            "size": "4x2",
            "col": 0,
            "row": 0,
            "config": {
              "slotCount": 2,
              "slot0_device": "quick",
              "slot0_sensor": "summary/cpu-usage",
              "slot0_design": "sparkline",
              "slot1_device": "quick",
              "slot1_sensor": "summary/memory-usage",
              "slot1_design": "halfgauge"
            }
          },
          {
            "type": "lighting",
            "size": "4x2",
            "col": 0,
            "row": 2
          },
          {
            "type": "cooling",
            "size": "4x2",
            "col": 0,
            "row": 4
          }
        ]
      },
      "q60": {
        "layoutSchemaVersion": 2,
        "surface": "q60",
        "widgets": [
          {
            "type": "clock",
            "size": "2x4",
            "col": 0,
            "row": 0
          }
        ]
      }
    }
  },

  "overlay": {
    "enabled": false,
    "alwaysOnTop": false,
    "scale": 100,
    "opacity": 1.0,
    "monitor": -1
  },

  "lighting": {
    "sync": "plasma",
    "brightnessEnabled": false,
    "speedEnabled": false,
    "frameRate": 60,
    "scaleRatio": 1.0,
    "musicReactive": true,
    "staticColor": { "r": 255, "g": 0, "b": 0 },
    "animate": {
      "effect": "plasma",
      "state": {
        "speed": 50,
        "intensity": 1.0,
        "hue": 0.0,
        "colorize": 0.0,
        "saturation": 1.0,
        "contrast": 1.0
      }
    },
    "postProcess": {
      "hue": 0.0,
      "colorize": 0.0,
      "saturation": 1.0,
      "contrast": 1.0,
      "reactivity": 0.5,
      "intensity": 0.5
    },
    "devicePreference": {
      "brightness": 100,
      "saturation": 1.0
    }
  },

  "y70": {
    "orientation": "Landscape",
    "brightness": 80,
    "screenOff": false,
    "forceOrientation": true
  },

  "keeb": {
    "rotaryLeft": "VolumeAdjustment",
    "rotaryRight": "BrightnessAdjustment",
    "firmwareLighting": {
      "animationMode": "Static",
      "speed": "Standard",
      "direction": "Forward",
      "brightness": 80,
      "keyReactive": false,
      "keyReactiveMask": false,
      "keyReactiveMode": "SingleKey"
    }
  },

  "cooling": {
    "globalSpeedModifier": 1.0,
    "activePreset": "off",
    "presets": {
      "silent":      { "responseTime": 3.0, "minTemp": 45, "maxTemp": 85, "minSpeed": 20, "maxSpeed": 70  },
      "balanced":    { "responseTime": 1.5, "minTemp": 35, "maxTemp": 75, "minSpeed": 30, "maxSpeed": 90  },
      "turbo":       { "responseTime": 0.5, "minTemp": 30, "maxTemp": 65, "minSpeed": 50, "maxSpeed": 100 }
    },
    "deviceLayoutSize": { "w": 80, "h": 80 }
  },

  "obs": {
    "host": "127.0.0.1",
    "port": 4455
  },

  "screenTime": {
    "trackingEnabled": true
  },

  "cnvs": {
    "playAnimation": true,
    "playWhenPCOff": false
  },

  "auth": {
    "remoteControlEnabled": true
  }
}
