<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Match the service's conditional TFM so the test project can reference it
         on Windows (the service is net10.0-windows there) and still run on
         macOS/Linux as plain net10.0. Lets the suite run on the Windows PC. -->
    <TargetFramework Condition="$(RuntimeIdentifier.StartsWith('win')) OR $([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="!$(RuntimeIdentifier.StartsWith('win')) AND !$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <!-- Mirror the service csproj's MACOS/LINUX constants (RID wins over host
         OS) so tests of platform-gated sources compile exactly where those
         sources exist in the referenced assembly. -->
    <DefineConstants Condition="$(RuntimeIdentifier.StartsWith('osx')) OR ('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('OSX')))">$(DefineConstants);MACOS</DefineConstants>
    <DefineConstants Condition="$(RuntimeIdentifier.StartsWith('linux')) OR ('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Linux')))">$(DefineConstants);LINUX</DefineConstants>
    <!-- Mirror the service's DEV_TOOLS define (-p:DevTools=true) so dev-only
         route contracts compile in the same flavour as the referenced assembly. -->
    <DefineConstants Condition="'$(DevTools)' == 'true'">$(DefineConstants);DEV_TOOLS</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- nexus.runsettings excludes Category=Manual (the long benchmark runs)
         by default so `dotnet test` stays fast. Run benchmarks with
         `dotnet test  filter "Category=Manual"` (single dash placeholder
         here to avoid the XML-comment double-dash restriction). -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)nexus.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Nexus.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Widget fixture bundles copy to the test output dir so registry tests
       can point at a real directory tree. Anything new under Widgets/Fixtures/
       is included automatically. -->
  <ItemGroup>
    <Content Include="Widgets/Fixtures/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Synthetic Elgato ProfilesV3 store (ElgatoProfileReader/Translator
       tests) copies to the test output dir the same way. -->
  <ItemGroup>
    <Content Include="Fixtures/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>


  <ItemGroup>
    <!-- xUnit reads this from the output dir; without the copy the suite falls
         back to maxParallelThreads = processor count. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Fixture firmware images under the same firmware/<deviceId>/<version>.hex
       logical names the service build uses, so BundledFirmwareCatalog is tested
       without the real vendor images (which live outside the repository). -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\firmware\**\*.hex">
      <LogicalName>firmware/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>