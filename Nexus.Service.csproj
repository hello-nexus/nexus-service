    <Compile Remove="src/Cooling/LinuxNvidiaFanProvider.cs" />
    <Compile Remove="src/Cooling/Nvml.cs" />
    <Compile Remove="src/Devices/Detection/LinuxUsbEnumerator.cs" />
    <Compile Remove="src/Lifecycle/LinuxStartupProvider.cs" />
    <Compile Remove="src/Panel/LinuxDesktopWallpaperProvider.cs" />
    <Compile Remove="src/Lighting/Capture/LinuxScreenCastHelper.cs" />
    <Compile Remove="src/Lighting/Capture/LinuxScreenCastPortal.cs" />
    <Compile Remove="src/Lighting/Capture/LinuxScreenFrameSource.cs" />
    <Compile Remove="src/Lighting/Engine/Gpu/LinuxEglContext.cs" />
    <Compile Remove="src/Peripherals/Hid/LinuxHidDevice.cs" />
    <Compile Remove="src/Peripherals/Hid/LinuxHidEnumerator.cs" />
    <Compile Remove="src/Peripherals/Hyte/Cnvs/LinuxCnvsPortDiscovery.cs" />
    <Compile Remove="src/Peripherals/Hyte/LinuxSerialDiscovery.cs" />
    <Compile Remove="src/Peripherals/Hyte/MiniHub/LinuxMiniHubPortDiscovery.cs" />
    <Compile Remove="src/Peripherals/Hyte/Np50/LinuxNp50PortDiscovery.cs" />
    <Compile Remove="src/Peripherals/Hyte/QSeriesCooler/LinuxQSeriesCoolerPortDiscovery.cs" />
    <Compile Remove="src/Peripherals/Hyte/SmartHub/LinuxSmartHubPortDiscovery.cs" />
    <Compile Remove="src/Peripherals/Hyte/Y70Display/LinuxY70DisplayPortDiscovery.cs" />
    <Compile Remove="src/Peripherals/Keeb/LinuxInputter.cs" />
    <Compile Remove="src/Platform/Displays/LinuxDisplayBrightnessProvider.cs" />
    <Compile Remove="src/Platform/Displays/LinuxDisplayTopologyProvider.cs" />
    <Compile Remove="src/Platform/Linux/DBus/DBusConnection.cs" />
    <Compile Remove="src/Platform/Linux/DBus/DBusTypes.cs" />
    <Compile Remove="src/Platform/Linux/LinuxBrowsers.cs" />
    <Compile Remove="src/Platform/Linux/LinuxKWinPanelPlacement.cs" />
    <Compile Remove="src/Platform/Linux/LinuxNotify.cs" />
    <Compile Remove="src/Platform/Linux/LinuxOverlayHost.cs" />
    <Compile Remove="src/Platform/Linux/LinuxScreenInhibit.cs" />
    <Compile Remove="src/Platform/Linux/LinuxPanelKioskHost.cs" />
    <Compile Remove="src/Platform/Linux/LinuxPerformanceProvider.cs" />
    <Compile Remove="src/Platform/Linux/LinuxResumeListener.cs" />
    <Compile Remove="src/Platform/Linux/LinuxSession.cs" />
    <Compile Remove="src/Platform/Linux/LinuxSysfs.cs" />
    <Compile Remove="src/Platform/Linux/LinuxSystemAccentProvider.cs" />
    <Compile Remove="src/Platform/Linux/LinuxTrayHost.cs" />
    <Compile Remove="src/Platform/Linux/LinuxTrayService.cs" />
    <Compile Remove="src/Sensors/LinuxSensorProvider.cs" />
  </ItemGroup>
  <!-- Build nexus-web for service and copy to wwwroot/.
       Skip with: dotnet build -p:BuildWeb=false -->
  <Target Name="BuildWebForService" BeforeTargets="Build" Condition="'$(BuildWeb)' != 'false' AND Exists('../nexus-web/package.json')">
    <Message Text="Building nexus-web for service..." Importance="high" />
    <!-- arch -arm64 ensures native node runs on Apple Silicon even if dotnet is x64 (Rosetta) -->
    <Exec Command="arch -arm64 npm run build:service" WorkingDirectory="../nexus-web" Condition="$([MSBuild]::IsOSPlatform('OSX'))" EnvironmentVariables="BUILD_TARGET=service" />
    <Exec Command="npm run build:service" WorkingDirectory="../nexus-web" Condition="!$([MSBuild]::IsOSPlatform('OSX'))" EnvironmentVariables="BUILD_TARGET=service" />
    <RemoveDir Directories="wwwroot" Condition="Exists('wwwroot')" />
    <MakeDir Directories="wwwroot" />
    <ItemGroup>
      <_WebDist Include="../nexus-web/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebDist)" DestinationFiles="@(_WebDist->'wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- Also copy to bin output so dotnet run finds wwwroot at runtime -->
    <Copy SourceFiles="@(_WebDist)" DestinationFiles="@(_WebDist->'$(OutputPath)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Trim SDK-generated files we don't need at runtime:
       - staticwebassets.endpoints.json: only used by MapStaticAssets() which we
         don't call (we use UseStaticFiles)
       - runtimeconfig.template.json: build-time template, AOT exes have no
         runtime config to populate
       - data/*.json: shipped as embedded resources by EmbeddedResource items;
         the Web SDK auto-copies project-tree json as Content, drop those
         duplicates -->
  <Target Name="TrimUnwantedPublishOutputs" AfterTargets="Publish">
    <ItemGroup>
      <_TrimFromPublish Include="$(PublishDir)$(AssemblyName).staticwebassets.endpoints.json" />
      <_TrimFromPublish Include="$(PublishDir)runtimeconfig.template.json" />
      <_TrimFromPublish Include="$(PublishDir)data\**\*.json" />
    </ItemGroup>
    <Delete Files="@(_TrimFromPublish)" />
    <RemoveDir Directories="$(PublishDir)data" Condition="Exists('$(PublishDir)data')" />
  </Target>

  <!-- macOS: wrap the published AOT binary into a proper .app bundle after publish -->
  <Target Name="PackageMacApp" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/Bundled/macos/build-app.sh&quot; &quot;$(PublishDir)&quot; &quot;$(PublishDir)..&quot;" />
  </Target>

  <!-- Publish the floating-widget overlay host (nexus-overlay.exe) into
       <publish>/overlay/ as part of the service publish on Windows. The
       overlay is itself an AOT-native binary (raw Win32 + direct
       WebView2 C-API P/Invoke) so the published payload is just
       nexus-overlay.exe + WebView2Loader.dll. It still lives in a
       subdirectory to keep its WebView2 user-data + COM scaffolding
       cleanly separated from the service root.

       Failure modes are hard <Error>s, not warnings: skipping the overlay
       leaves the desktop widgets feature silently broken (host not found,
       launcher logs one line, no widgets render, no user-visible failure). -->
  <!-- Probe two layouts because Mac dev tree uses sibling `nexus-overlay/`
       while the Windows deploy strips the `nexus-` prefix to bare `overlay/`
       (the lab-PC deploy layout). The first one that exists wins. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <_OverlayProjectMac>$(MSBuildThisFileDirectory)..\nexus-overlay\Nexus.Overlay.csproj</_OverlayProjectMac>
    <_OverlayProjectPc>$(MSBuildThisFileDirectory)..\overlay\Nexus.Overlay.csproj</_OverlayProjectPc>
    <_OverlayProject Condition="Exists('$(_OverlayProjectMac)')">$(_OverlayProjectMac)</_OverlayProject>
    <_OverlayProject Condition="'$(_OverlayProject)' == '' AND Exists('$(_OverlayProjectPc)')">$(_OverlayProjectPc)</_OverlayProject>
  </PropertyGroup>

  <Target Name="EnsureOverlayProject" BeforeTargets="Publish"
          Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <Error Condition="'$(_OverlayProject)' == ''"
           Text="Cannot publish service for Windows: nexus-overlay project not found. Looked at '$(_OverlayProjectMac)' and '$(_OverlayProjectPc)'. The desktop widgets host (nexus-overlay.exe) cannot be built. Sync or restore the sibling repo before publishing." />
  </Target>

  <Target Name="PublishOverlayHost" AfterTargets="Publish"
          Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <PropertyGroup>
      <!-- EnsureTrailingSlash defends against -p:PublishDir=foo\bar (no slash)
           collapsing the concat into 'foo\baroverlay\'. -->
      <_OverlayPublishDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))overlay\</_OverlayPublishDir>
      <!-- Strip the trailing '\' before quoting in the Exec command: on
           Windows cmd.exe / dotnet's arg parser, "...\" is interpreted as an
           escaped quote, which can collapse the rest of the command line. -->
      <_OverlayPublishDirArg>$(_OverlayPublishDir.TrimEnd('\'))</_OverlayPublishDirArg>
    </PropertyGroup>
    <Message Text="Publishing nexus-overlay (desktop widget host) -&gt; $(_OverlayPublishDir)" Importance="high" />
    <Exec Command="dotnet publish &quot;$(_OverlayProject)&quot; -c Release -r win-x64 --self-contained true -o &quot;$(_OverlayPublishDirArg)&quot;" />
    <Error Condition="!Exists('$(_OverlayPublishDir)nexus-overlay.exe')"
           Text="Overlay publish completed without the host EXE at $(_OverlayPublishDir)nexus-overlay.exe. Desktop widgets will not run." />
    <Error Condition="!Exists('$(_OverlayPublishDir)WebView2Loader.dll')"
           Text="Overlay publish missing WebView2Loader.dll at $(_OverlayPublishDir). Host process would start but WebView2 init would fail silently and no widgets would render." />
    <!-- The overlay rewrite drops the managed Microsoft.Web.WebView2.Core
         wrapper (NativeAOT-incompatible) and the WinForms host entirely. It
         P/Invokes WebView2Loader.dll directly and walks COM vtables. The
         only files that need to land are nexus-overlay.exe + WebView2Loader.dll. -->
    <!-- ILC writes a 20+ MB pdb AFTER the overlay's own AfterTargets="Publish"
         strip target runs, so we cannot remove it from the overlay side.
         Delete it here, after the overlay publish has fully settled, to keep
         debug symbols out of Nexus-Setup.exe. -->
    <Delete Files="$(_OverlayPublishDir)nexus-overlay.pdb" />
  </Target>

  <!-- Bundled SDK apps, from the separate private `nexus-apps` submodule
       (../nexus-apps in this layout). apps/<id>/ is source; that repo's
       `npm run build` assembles a complete, source-free ship tree, which we
       copy wholesale - exactly as BuildWebForService copies nexus-web's dist
       into wwwroot - so this file needs no per-file knowledge of a payload.
       Building it here (rather than committing the bundle) keeps what ships in
       step with the SDK runtime it is built against.

       nexus-apps is OPTIONAL and private: a tree without it builds a complete
       service that ships zero bundled apps, which AppRegistry already handles
       (AppInstallPaths hands it a root that does not exist, and the scan
       returns). Do not reinstate a hard error for the ABSENT case - it makes a
       public clone of the umbrella unbuildable. The one error below is
       narrower and fires only when the repo IS present but predates the ship
       tree, which would otherwise ship an app-less build with no signal.

       NOTE: NexusAppsRoot now names the repo ROOT, not its apps/ subdir - the
       build script lives at the root. -->
  <PropertyGroup>
    <NexusAppsRoot Condition="'$(NexusAppsRoot)' == ''">$(MSBuildThisFileDirectory)..\nexus-apps</NexusAppsRoot>
    <NexusAppsAvailable>false</NexusAppsAvailable>
    <NexusAppsAvailable Condition="Exists('$(NexusAppsRoot)')">true</NexusAppsAvailable>
    <!-- Absolute: the build Exec runs with WorkingDirectory=$(NexusAppsRoot),
         so a relative out path would land in the payload repo, not here. Under
         this project's obj/ because every worktree reaches nexus-apps through a
         symlink to ONE shared checkout - a shared output tree would let
         concurrent builds race and would dirty another checkout. -->
    <NexusAppsDist Condition="'$(NexusAppsDist)' == ''">$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)nexus-apps-dist</NexusAppsDist>
  </PropertyGroup>
  <Target Name="ReportNexusAppsSubmodule" BeforeTargets="BeforeBuild">
    <Message Importance="high" Condition="'$(NexusAppsAvailable)' != 'true'"
             Text="nexus-apps not present at $(NexusAppsRoot); building with no bundled apps. To include them: git submodule update --init nexus-apps" />
  </Target>

  <!-- Assemble the ship tree from source. The bundler resolves its deps from
       nexus-web/sdk/node_modules (an isolated react@18 project - the host app
       is react@19), which CI installs explicitly; a job with no node passes
       -p:BuildApps=false, the same escape hatch BuildWeb offers. -->
  <Target Name="BuildAppsForService" BeforeTargets="Build"
          Condition="'$(BuildApps)' != 'false' AND '$(NexusAppsAvailable)' == 'true'">
    <Error Condition="!Exists('$(NexusAppsRoot)\scripts\build.mjs')"
           Text="nexus-apps at $(NexusAppsRoot) has no scripts/build.mjs - its pointer is behind this nexus-service. Bump both submodules together, or pass -p:BuildApps=false to build without bundled apps." />
    <Message Text="Building nexus-apps payload..." Importance="high" />
    <Exec Command="node scripts/build.mjs --out &quot;$(NexusAppsDist)&quot;" WorkingDirectory="$(NexusAppsRoot)" />
    <Error Condition="!Exists('$(NexusAppsDist)')"
           Text="nexus-apps build produced no payload at $(NexusAppsDist)." />
  </Target>

  <!-- Copied by target, not a Content glob: the ship tree is generated by the
       target above, and a Content ItemGroup is evaluated before any target
       runs, so a static glob would never see it. Both item groups live inside
       their targets for the same reason. -->
  <Target Name="CopyAppsToOutput" AfterTargets="BuildAppsForService" Condition="Exists('$(NexusAppsDist)')">
    <RemoveDir Directories="$(OutputPath)apps" Condition="Exists('$(OutputPath)apps')" />
    <ItemGroup>
      <_NexusAppFile Include="$(NexusAppsDist)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_NexusAppFile)"
          DestinationFiles="@(_NexusAppFile->'$(OutputPath)apps/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish leg. PackageMacApp is declared earlier, so on macOS it runs first
       and its .app never sees these files. macOS ships no bundled apps today
       for a second, independent reason: build-app.sh copies the pre-rename
       $STAGING/widgets path, while AppInstallPaths scans <BaseDirectory>/apps.
       Fixing one of the two alone changes nothing. Windows and Linux package
       $(PublishDir) after this target, so both carry the payload. -->
  <Target Name="CopyAppsToPublish" AfterTargets="Publish" Condition="Exists('$(NexusAppsDist)')">
    <PropertyGroup>
      <_NexusPublishDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_NexusPublishDir>
    </PropertyGroup>
    <ItemGroup>
      <_NexusAppPublishFile Include="$(NexusAppsDist)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_NexusAppPublishFile)"
          DestinationFiles="@(_NexusAppPublishFile->'$(_NexusPublishDir)apps/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>


  <!-- GitHub Actions sets GITHUB_ACTIONS=true on every runner; nothing local
       (including a build-pc tar sync, which has no .git) sets it. build.yml
       overwrites the VERSION file with the release version before invoking
       MSBuild when a version was supplied, so a CI build's committed-VERSION
       read path is unaffected by the local-dev override below. -->
  <PropertyGroup>
    <_NexusIsCiBuild>false</_NexusIsCiBuild>
    <_NexusIsCiBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</_NexusIsCiBuild>
    <_NexusDevVersion>3.0.0-dev</_NexusDevVersion>
  </PropertyGroup>

  <!-- Drive the exe's Win32 file/product version from VERSION; without this the
       Details tab defaults to 1.0.0.0. FileVersion/AssemblyVersion must be
       numeric, so the -beta.N prerelease rides only on InformationalVersion,
       which surfaces as "Product version". Evaluated at property time so the
       attributes are set before GenerateAssemblyInfo runs. -->
  <PropertyGroup>
    <_NexusVersionFile>$(MSBuildThisFileDirectory)VERSION</_NexusVersionFile>
    <_NexusVersionRaw Condition="Exists('$(_NexusVersionFile)')">$([System.IO.File]::ReadAllText('$(_NexusVersionFile)'))</_NexusVersionRaw>
    <_NexusVersionFull>$([System.String]::Copy('$(_NexusVersionRaw)').Split(';')[0].Trim())</_NexusVersionFull>
    <_NexusVersionFull Condition="'$(_NexusVersionFull)' == ''">0.0.0</_NexusVersionFull>
    <_NexusVersionFull Condition="'$(_NexusIsCiBuild)' != 'true'">$(_NexusDevVersion)</_NexusVersionFull>
    <_NexusVersionNumeric>$([System.String]::Copy('$(_NexusVersionFull)').Split('-')[0])</_NexusVersionNumeric>
    <Version>$(_NexusVersionFull)</Version>
    <InformationalVersion>$(_NexusVersionFull)</InformationalVersion>
    <FileVersion>$(_NexusVersionNumeric)</FileVersion>
    <AssemblyVersion>$(_NexusVersionNumeric)</AssemblyVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Bake VERSION file contents as the build version. Local (non-CI) builds
       report 3.0.0-dev instead, so a dev build is never mistaken for the
       committed release version; falls back to 3.0.0-beta.0 only if -dev
       ever breaks VersionCompare/UpdateService (see VersionCompareTests). -->
  <Target Name="SetGitVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <VersionFilePath>$(MSBuildThisFileDirectory)VERSION</VersionFilePath>
    </PropertyGroup>
    <ReadLinesFromFile File="$(VersionFilePath)" Condition="Exists('$(VersionFilePath)')">
      <Output TaskParameter="Lines" PropertyName="VersionFileContents" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <VersionFileContents Condition="'$(VersionFileContents)' == ''">0.0.0</VersionFileContents>
      <!-- Split on ";" (ReadLinesFromFile joins lines with ";") and take the first element. -->
      <NexusBuildVersion>v$([System.String]::Copy('$(VersionFileContents)').Split(';')[0].Trim())</NexusBuildVersion>
      <NexusBuildVersion Condition="'$(_NexusIsCiBuild)' != 'true'">v$(_NexusDevVersion)</NexusBuildVersion>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)GitVersion.g.cs" Lines="namespace Nexus.Service { internal static partial class BuildInfo { public const string Version = &quot;$(NexusBuildVersion)&quot;%3B } }" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)GitVersion.g.cs" />
    </ItemGroup>
  </Target>

  <!-- Bake the build credential the same way as the version. The token never
       enters the source tree, a PR diff, or a public clone - it exists only in
       the CI secret store and in obj/. Always written (empty when absent) so
       BuildInfo.ClientToken resolves in every configuration. -->
  <Target Name="SetClientCredential" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)ClientCredential.g.cs" Lines="namespace Nexus.Service { internal static partial class BuildInfo { public const string ClientToken = &quot;$(NexusClientToken)&quot;%3B public const string PostHogKey = &quot;$(NexusPostHogKey)&quot;%3B } }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ClientCredential.g.cs" />
    </ItemGroup>
  </Target>

</Project>
