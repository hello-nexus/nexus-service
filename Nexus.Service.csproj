  </ItemGroup>
  <!-- Build nexus-web for service and copy to wwwroot/.
       Skip with: dotnet build -p:BuildWeb=false -->
  <Target Name="BuildWebForService" BeforeTargets="Build" Condition="'$(BuildWeb)' != 'false' AND Exists('../nexus-web/package.json')">
    <Message Text="Building nexus-web for service..." Importance="high" />
    <!-- arch -arm64 ensures native node runs on Apple Silicon even if dotnet is x64 (Rosetta) -->
    <Exec Command="arch -arm64 npm run build:service" WorkingDirectory="../nexus-web" Condition="$([MSBuild]::IsOSPlatform('OSX'))" EnvironmentVariables="BUILD_TARGET=service" />
    <Exec Command="npm run build:service" WorkingDirectory="../nexus-web" Condition="!$([MSBuild]::IsOSPlatform('OSX'))" EnvironmentVariables="BUILD_TARGET=service" />
    <RemoveDir Directories="wwwroot" Condition="Exists('wwwroot')" />
    <MakeDir Directories="wwwroot" />
    <ItemGroup>
      <_WebDist Include="../nexus-web/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebDist)" DestinationFiles="@(_WebDist->'wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- Also copy to bin output so dotnet run finds wwwroot at runtime -->
    <Copy SourceFiles="@(_WebDist)" DestinationFiles="@(_WebDist->'$(OutputPath)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Trim SDK-generated files we don't need at runtime:
       - staticwebassets.endpoints.json: only used by MapStaticAssets() which we
         don't call (we use UseStaticFiles)
       - runtimeconfig.template.json: build-time template, AOT exes have no
         runtime config to populate
       - data/*.json: shipped as embedded resources by EmbeddedResource items;
         the Web SDK auto-copies project-tree json as Content, drop those
         duplicates -->
  <Target Name="TrimUnwantedPublishOutputs" AfterTargets="Publish">
    <ItemGroup>
      <_TrimFromPublish Include="$(PublishDir)$(AssemblyName).staticwebassets.endpoints.json" />
      <_TrimFromPublish Include="$(PublishDir)runtimeconfig.template.json" />
      <_TrimFromPublish Include="$(PublishDir)data\**\*.json" />
    </ItemGroup>
    <Delete Files="@(_TrimFromPublish)" />
    <RemoveDir Directories="$(PublishDir)data" Condition="Exists('$(PublishDir)data')" />
  </Target>

  <!-- macOS: wrap the published AOT binary into a proper .app bundle after publish -->
  <Target Name="PackageMacApp" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/Bundled/macos/build-app.sh&quot; &quot;$(PublishDir)&quot; &quot;$(PublishDir)..&quot;" />
  </Target>

  <!-- Publish the floating-widget overlay host (nexus-overlay.exe) into
       <publish>/overlay/ as part of the service publish on Windows. The
       overlay is itself an AOT-native binary (raw Win32 + direct
       WebView2 C-API P/Invoke) so the published payload is just
       nexus-overlay.exe + WebView2Loader.dll. It still lives in a
       subdirectory to keep its WebView2 user-data + COM scaffolding
       cleanly separated from the service root.

       Failure modes are hard <Error>s, not warnings: skipping the overlay
       leaves the desktop widgets feature silently broken (host not found,
       launcher logs one line, no widgets render, no user-visible failure). -->
  <!-- Probe two layouts because Mac dev tree uses sibling `nexus-overlay/`
       while the Windows deploy strips the `nexus-` prefix to bare `overlay/`
       (per .agents/skills/build-pc/SKILL.md). The first one that exists wins. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <_OverlayProjectMac>$(MSBuildThisFileDirectory)..\nexus-overlay\Nexus.Overlay.csproj</_OverlayProjectMac>
    <_OverlayProjectPc>$(MSBuildThisFileDirectory)..\overlay\Nexus.Overlay.csproj</_OverlayProjectPc>
    <_OverlayProject Condition="Exists('$(_OverlayProjectMac)')">$(_OverlayProjectMac)</_OverlayProject>
    <_OverlayProject Condition="'$(_OverlayProject)' == '' AND Exists('$(_OverlayProjectPc)')">$(_OverlayProjectPc)</_OverlayProject>
  </PropertyGroup>

  <Target Name="EnsureOverlayProject" BeforeTargets="Publish"
          Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <Error Condition="'$(_OverlayProject)' == ''"
           Text="Cannot publish service for Windows: nexus-overlay project not found. Looked at '$(_OverlayProjectMac)' and '$(_OverlayProjectPc)'. The desktop widgets host (nexus-overlay.exe) cannot be built. Sync or restore the sibling repo before publishing." />
  </Target>

  <Target Name="PublishOverlayHost" AfterTargets="Publish"
          Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <PropertyGroup>
      <!-- EnsureTrailingSlash defends against -p:PublishDir=foo\bar (no slash)
           collapsing the concat into 'foo\baroverlay\'. -->
      <_OverlayPublishDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))overlay\</_OverlayPublishDir>
      <!-- Strip the trailing '\' before quoting in the Exec command: on
           Windows cmd.exe / dotnet's arg parser, "...\" is interpreted as an
           escaped quote, which can collapse the rest of the command line. -->
      <_OverlayPublishDirArg>$(_OverlayPublishDir.TrimEnd('\'))</_OverlayPublishDirArg>
    </PropertyGroup>
    <Message Text="Publishing nexus-overlay (desktop widget host) -&gt; $(_OverlayPublishDir)" Importance="high" />
    <Exec Command="dotnet publish &quot;$(_OverlayProject)&quot; -c Release -r win-x64 --self-contained true -o &quot;$(_OverlayPublishDirArg)&quot;" />
    <Error Condition="!Exists('$(_OverlayPublishDir)nexus-overlay.exe')"
           Text="Overlay publish completed without the host EXE at $(_OverlayPublishDir)nexus-overlay.exe. Desktop widgets will not run." />
    <Error Condition="!Exists('$(_OverlayPublishDir)WebView2Loader.dll')"
           Text="Overlay publish missing WebView2Loader.dll at $(_OverlayPublishDir). Host process would start but WebView2 init would fail silently and no widgets would render." />
    <!-- The overlay rewrite drops the managed Microsoft.Web.WebView2.Core
         wrapper (NativeAOT-incompatible) and the WinForms host entirely. It
         P/Invokes WebView2Loader.dll directly and walks COM vtables. The
         only files that need to land are nexus-overlay.exe + WebView2Loader.dll. -->
    <!-- ILC writes a 20+ MB pdb AFTER the overlay's own AfterTargets="Publish"
         strip target runs, so we cannot remove it from the overlay side.
         Delete it here, after the overlay publish has fully settled, to keep
         debug symbols out of Nexus-Setup.exe. -->
    <Delete Files="$(_OverlayPublishDir)nexus-overlay.pdb" />
  </Target>

  <!-- First-party + community apps. Live in the separate `nexus-apps`
       submodule (../nexus-apps in this layout), one dir per app under apps/<id>/
       (manifest.json + the built widget.mjs). MSBuild copies them into
       <output>/apps/<id>/, the bundled-install root the AppRegistry scans
       (an app's widget facet renders from widget.mjs in the sandboxed host).
       The Web SDK's default Content include sometimes shadows the Link
       metadata; remove + re-add to ensure our metadata wins. -->
  <PropertyGroup>
    <NexusAppsRoot Condition="'$(NexusAppsRoot)' == ''">$(MSBuildThisFileDirectory)..\nexus-apps\apps</NexusAppsRoot>
  </PropertyGroup>
  <Target Name="CheckNexusAppsSubmodule" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(NexusAppsRoot)')"
           Text="nexus-apps submodule missing at $(NexusAppsRoot). Run: git submodule update --init nexus-apps" />
  </Target>
  <ItemGroup>
    <Content Remove="$(NexusAppsRoot)\**\*" />
    <Content Include="$(NexusAppsRoot)\**\*">
      <Link>apps\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Bake git commit count as version -->
  <Target Name="SetGitVersion" BeforeTargets="CoreCompile">
    <Exec Command="git rev-list --count HEAD 2>NUL" ConsoleToMsBuild="true" IgnoreExitCode="true"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
    </Exec>
    <Exec Command="git rev-list --count HEAD 2>/dev/null" ConsoleToMsBuild="true" IgnoreExitCode="true"
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
    </Exec>
    <PropertyGroup>
      <GitCommitCount Condition="'$(GitCommitCount)' == ''">0</GitCommitCount>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)GitVersion.g.cs" Lines="namespace Nexus.Service { internal static partial class BuildInfo { public const string Version = &quot;v$(GitCommitCount)&quot;%3B } }" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)GitVersion.g.cs" />
    </ItemGroup>
  </Target>

</Project>
