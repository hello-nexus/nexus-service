<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Windows builds target a Win10-versioned TFM so we can use C#/WinRT
         projections (Windows.Media.Control for GSMTC media sessions, etc).
         macOS/Linux stay on plain net10.0. The condition keys on RID first so
         cross-compilation from Mac (`-r win-x64`) picks the Windows TFM. -->
    <TargetFramework Condition="$(RuntimeIdentifier.StartsWith('win')) OR $([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="!$(RuntimeIdentifier.StartsWith('win')) AND !$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$(RuntimeIdentifier.StartsWith('win')) OR $([MSBuild]::IsOSPlatform('Windows'))">10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting Condition="!$([MSBuild]::IsOSPlatform('Windows'))">true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Nexus.Service</RootNamespace>
    <AssemblyName>Nexus</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Workstation GC: this is a background hardware service, not a throughput
         server. The Web SDK default (Server GC) commits a per-core heap, which
         on a 16-core box reserves ~90 MB to hold ~30 MB live. Workstation keeps
         one heap; gen0 collects more often but cheaper, irrelevant at this
         allocation rate. Background (concurrent) GC stays on. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- WinExe subsystem on Windows: no console window, service lives in system tray only -->
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <!-- Embed Win32 manifest with requestedExecutionLevel=highestAvailable so
         double-clicking the EXE on an admin account triggers UAC and runs
         elevated. Standard accounts launch unelevated (no prompt). The
         scheduled task path is unaffected (it sets RunLevel separately). -->
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows')) OR $(RuntimeIdentifier.StartsWith('win'))">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- AOT size-reduction feature switches. EventSourceSupport=false is safe:
       the FPS provider consumes OS ETW via TraceEventSession, not managed
       EventSource; it does disable dotnet-counters/dotnet-trace on this
       process. Hot-reload, debugger-attach, and HTTP trace-header propagation
       are unused in the shipped service. StackTraceSupport and
       UseSystemResourceKeys are left at their defaults so field logs keep
       exception stack traces and readable framework messages. -->
  <PropertyGroup>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
  </PropertyGroup>

  <!-- TraceEvent ships DIA/ETL symbol+relog native helpers: msdia140.dll +
       KernelTraceControl.dll under a host-ProcessorArchitecture subdir
       (amd64/x86/arm64), plus Dia2Lib.dll and TraceReloggerLib.dll in the root.
       The FPS provider's real-time DXGKRNL session uses in-box ETW APIs and
       never resolves symbols, so none are loaded; verified on T1 by deleting
       them and confirming live FPS capture survives. Strip every arch subdir so
       the output is the same regardless of which host runs the publish. -->
  <Target Name="StripTraceEventNatives" AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) OR $(RuntimeIdentifier.StartsWith('win'))">
    <Delete Files="$(PublishDir)Dia2Lib.dll;$(PublishDir)TraceReloggerLib.dll" />
    <RemoveDir Directories="$(PublishDir)amd64;$(PublishDir)x86;$(PublishDir)arm64" />
  </Target>

  <!-- Windows: define WINDOWS constant + include LibreHardwareMonitor.
       Supports both native builds (IsOSPlatform) and cross-compilation (RID starts with 'win'). -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) OR $(RuntimeIdentifier.StartsWith('win'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <!-- The Web SDK auto-includes the entire Bundled/ tree as Content, which
         dragged macOS/Linux artifacts (Bundled/macos, Bundled/osx-arm64, …)
         into the Windows publish output and from there into Nexus-Setup.exe.
         Exclude Bundled from the default item globs on Windows; the explicit
         per-RID <Content Include="Bundled\win-x64\…"> items below still ship
         exactly the win-x64 set (openrgb, dfu-util, dfu-driver, ffmpeg,
         pawnio), relocated via their <Link>. macOS/Linux builds are
         unaffected. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Bundled\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- macOS / Linux: define MACOS / LINUX so platform provider selection is a
       compile-time choice, not a runtime if(). Each platform build then only
       references its own concrete providers, which lets the per-platform
       <Compile Remove> groups below drop the other platforms' files entirely
       (otherwise the cross-platform binary carries dead Linux+Mac native code).
       RID-keyed first so cross-compiling from any host picks the right set. -->
  <!-- RID wins when set (so cross-compiling win-x64 from a Mac host does NOT
       also define MACOS); host OS is only the fallback for a RID-less dev/test
       build. Exactly one of WINDOWS/MACOS/LINUX is ever defined. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx')) OR ('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('OSX')))">
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) OR ('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('Linux')))">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <!-- OFFICIAL_BUILD: derived, never set by hand. The build credential is the
       single input - CI mints a signed token into $(NEXUS_CLIENT_TOKEN); a lab
       machine keeps a long-lived dev token at ~/.nexus-build/client-token. A
       public clone has neither, so every path to our backend is gated off at
       registration and at each egress point. The define makes IsOfficial a
       constant false rather than a runtime read, so those paths are also
       unreachable. The web half reads the same credential in vite.config.ts,
       which is what keeps the two from disagreeing. -->
  <PropertyGroup>
    <_NexusClientTokenFile Condition="'$(USERPROFILE)' != ''">$(USERPROFILE)\.nexus-build\client-token</_NexusClientTokenFile>
    <_NexusClientTokenFile Condition="'$(_NexusClientTokenFile)' == ''">$(HOME)/.nexus-build/client-token</_NexusClientTokenFile>
    <NexusClientToken Condition="'$(NexusClientToken)' == ''">$(NEXUS_CLIENT_TOKEN)</NexusClientToken>
    <NexusClientToken Condition="'$(NexusClientToken)' == '' AND Exists('$(_NexusClientTokenFile)')">$([System.IO.File]::ReadAllText('$(_NexusClientTokenFile)').Trim())</NexusClientToken>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NexusClientToken)' != ''">
    <DefineConstants>$(DefineConstants);OFFICIAL_BUILD</DefineConstants>
  </PropertyGroup>

  <!-- Our PostHog project key, injected the same way. A fork shipping it would
       file its installs under our analytics, so it is not committed. -->
  <PropertyGroup>
    <NexusPostHogKey Condition="'$(NexusPostHogKey)' == ''">$(NEXUS_POSTHOG_KEY)</NexusPostHogKey>
  </PropertyGroup>

  <!-- DEV_TOOLS: internal/test builds only. Publish with -p:DevTools=true to
       include firmware downgrade / cross-branch flashing (status DevImages +
       the TryStart allowance). Off by default so release publishes don't carry
       the brick-capable paths. Mirrors the web __DEV_TOOLS__ build define. -->
  <PropertyGroup Condition="'$(DevTools)' == 'true'">
    <DefineConstants>$(DefineConstants);DEV_TOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) OR $(RuntimeIdentifier.StartsWith('win'))">
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre726" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.13" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="9.0.0" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <!-- WindowsMediaController wraps GlobalSystemMediaTransportControlsSessionManager
         (GSMTC) and exposes a Sessions dictionary + change events. Same library
         the reference Windows control service uses; survives AOT because the
         Windows TFM gives us C#/WinRT projections at compile time. -->
    <PackageReference Include="Dubya.WindowsMediaController" Version="2.5.6" />
    <!-- LibreHardwareMonitorLib transitively pulls Mono.Posix.NETStandard for
         Linux/macOS file IO. On Windows nothing in LHM hits those code paths,
         so the native libMonoPosixHelper.dll + MonoPosixHelper.dll (~1.5 MB)
         are dead weight in the publish. Keep the managed ref so LHM compiles,
         strip the native blobs. -->
    <PackageReference Include="Mono.Posix.NETStandard" Version="1.0.0" ExcludeAssets="native" />
  </ItemGroup>

  <!-- Cross-platform OpenGL for GPU-rendered lighting effects. Silk.NET binds to
       the native GL driver via P/Invoke (AOT-safe) and GLFW provides a hidden
       window + context. OpenTK.redist.glfw ships the GLFW native blob - we
       reference it directly with GeneratePathProperty so the CopyGlfwNative
       target below can find the per-RID dll/dylib without hard-coding a
       version in the path. -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing.Glfw" Version="2.22.0" />
    <PackageReference Include="OpenTK.redist.glfw" Version="3.3.0-pre20200830200122" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- System.IO.Ports: serial-port IO for HYTE NP50 (CDC virtual COM). The
       Windows package brings native serial helpers; on Linux we read /dev/ttyACM
       directly. AOT-compatible since .NET 7. -->
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.11" />
  </ItemGroup>

  <!-- QRCoder: pure-managed QR code SVG generation for the panel phone pairing flow. -->
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- OpenAPI document generation for docs/openapi.json (the REST-route
       inventory). The .NET 10 stack is AOT-compatible; the doc is produced by
       the emit-openapi CLI path, and MapOpenApi() is DEBUG-only so a release
       build exposes no endpoint. AspNetCore.OpenApi tracks the ASP.NET runtime;
       Microsoft.OpenApi is pinned directly to 2.7.5 (overriding the 2.0.0 the
       former pulls transitively) to clear advisory GHSA-v5pm-xwqc-g5wc. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <!-- SIPSorcery: WebRTC DataChannel direct P2P transport for the phone panel
       (STUN only, no TURN; the cloud relay stays as fallback). AOT-verified on
       osx-arm64 + win-x64. TrimmerRoots.xml keeps SctpTransportCookie's
       properties reachable for SIPSorcery's embedded reflection-based TinyJson
       serializer, which every SCTP COOKIE ECHO handshake depends on. -->
  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <!-- DPAPI at-rest protection for small secrets (Steam API key, Discord
       client secret). Cross-platform package; throws PlatformNotSupportedException
       off-Windows, which SecretProtector guards behind OperatingSystem.IsWindows(). -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <!-- AdvancedSharpAdbClient: pure-managed adb-server protocol client used by
       QSeriesPortWatcher to keep `adb reverse tcp:9400` alive while a HYTE Q60/Q80
       USB display is attached. Smoke-tested AOT on win-x64 + osx-arm64
       (2026-05-16): no trim warnings, no reflection-required types we hit at
       runtime. -->
  <ItemGroup>
    <PackageReference Include="AdvancedSharpAdbClient" Version="3.4.14" />
  </ItemGroup>

  <!-- Host-side raster rendering for the Lian Li Wireless SL-LCD sensor/clock/
       animation screen content (Slv3LcdSensorRenderer/ClockRenderer/
       AnimationRenderer): draws a 400x400 gauge/clock/animation frame and
       encodes it to JPEG without shelling out to ffmpeg per frame. AOT-clean
       (0 IL warnings) on win-x64 + osx-arm64. Pinned to the versions that
       clear every published SixLabors.ImageSharp NuGet advisory (the GIF
       decoder infinite-loop and out-of-bounds-write CVEs are fixed at
       3.1.11/3.1.7; lower 3.1.x patch versions trip the audit warning). -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
  </ItemGroup>

  <!-- AOT publish strips native assets from `runtimes/<rid>/native/` that aren't
       statically referenced. Silk.NET loads GLFW via dynamic P/Invoke, so we
       manually copy the native into the publish dir. -->
  <Target Name="CopyGlfwNative" AfterTargets="Publish">
    <ItemGroup>
      <_GlfwWin Include="$(PkgOpenTK_redist_glfw)\runtimes\win-x64\native\glfw3.dll" />
      <_GlfwMac Include="$(PkgOpenTK_redist_glfw)\runtimes\osx\native\libglfw.3.dylib" />
      <_GlfwLinux Include="$(PkgOpenTK_redist_glfw)\runtimes\linux-x64\native\libglfw.so.3" />
    </ItemGroup>
    <Copy SourceFiles="@(_GlfwWin)" DestinationFolder="$(PublishDir)"
          Condition="$(RuntimeIdentifier.StartsWith('win')) AND Exists('@(_GlfwWin)')" />
    <Copy SourceFiles="@(_GlfwMac)" DestinationFolder="$(PublishDir)"
          Condition="$(RuntimeIdentifier.StartsWith('osx')) AND Exists('@(_GlfwMac)')" />
    <Copy SourceFiles="@(_GlfwLinux)" DestinationFolder="$(PublishDir)"
          Condition="$(RuntimeIdentifier.StartsWith('linux')) AND Exists('@(_GlfwLinux)')" />
  </Target>

  <!-- icon.ico is embedded in the exe via <ApplicationIcon> above (Win32
       resource ID 32512). TrayIcon.cs and the OS taskbar load it from there;
       no need to also ship the loose file. -->
  <ItemGroup>
    <None Include="icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Expose internal test-only helpers (e.g. USB enumerator parsers) to the xUnit project -->
  <ItemGroup>
    <InternalsVisibleTo Include="Nexus.Service.Tests" />
    <InternalsVisibleTo Include="Nexus.Service.Benchmarks" />
  </ItemGroup>

  <!-- Static data assets shipped with the service live under data/. Files are
       baked in as embedded resources so the AOT binary is fully self-contained.
       openrgb-supported-devices.json is extracted from the openrgb-headless
       source by scripts/extract-supported-devices.py in the nexus-rgb repo. -->
  <ItemGroup>
    <EmbeddedResource Include="data\openrgb-supported-devices.json">
      <LogicalName>openrgb-supported-devices.json</LogicalName>
    </EmbeddedResource>
    <!-- Canonical install-time defaults. Read once by InstallDefaults at
         startup and exposed to every subsystem (FanProfiles, NexusSettings,
         PanelLayoutDefaults, etc.) so default values live in exactly one
         file instead of scattered C# initializers. -->
    <EmbeddedResource Include="data\install-defaults.json">
      <LogicalName>install-defaults.json</LogicalName>
    </EmbeddedResource>
    <!-- Canonical default template bundles per animate effect: served by
         GET /lighting/animate/defaults, used to prune persisted templates to
         user deltas and to resolve missing slots for thumbnails and reapply.
         Read once by AnimateTemplateDefaults. -->
    <EmbeddedResource Include="data\default-animate-templates.json">
      <LogicalName>default-animate-templates.json</LogicalName>
    </EmbeddedResource>
    <!-- Built-in Tryx Panorama preset cover thumbnails (default_01..06), served as
         data URLs by /tryx/presets; the panel can't produce them. -->
    <EmbeddedResource Include="src\Peripherals\Tryx\Panorama\PresetThumbs\*.jpg">
      <LogicalName>tryx-preset-%(Filename).jpg</LogicalName>
    </EmbeddedResource>
    <!-- Lucide weather condition glyphs (white on transparent), rasterized from
         the same lucide source nexus-web's WeatherIcon uses so the physical-key
         tile matches DeckWeatherCell. Loaded by WeatherTileRenderer. -->
    <EmbeddedResource Include="src\Rendering\WeatherIcons\*.png">
      <LogicalName>weather-icon-%(Filename).png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- GLSL fragment shaders: one file per animate effect under
       src/Lighting/Engine/Gpu/Shaders/. Loaded at runtime from the assembly
       manifest by ShaderLibrary.cs so AOT single-file publish works.
       LogicalName pins the manifest resource name to a stable identifier
       independent of source-folder layout (ShaderLibrary.cs hardcodes the
       prefix). -->
  <ItemGroup>
    <EmbeddedResource Include="src\Lighting\Engine\Gpu\Shaders\**\*.frag">
      <LogicalName>Nexus.Service.Lighting.Engine.Gpu.Shaders.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Bundled device firmware images, <dir>/<deviceId>/<version>.hex, embedded as
       firmware/<deviceId>/<version>.hex for BundledFirmwareCatalog. Vendor files
       kept outside this repository; probe order: $(NexusFirmwareDir) or
       NEXUS_FIRMWARE_DIR, the gitignored data/firmware drop-in, ../firmware,
       ../../firmware. None found = empty catalog (see EnsureFirmwareBundle). -->
  <PropertyGroup>
    <NexusFirmwareDir Condition="'$(NexusFirmwareDir)' == ''">$(NEXUS_FIRMWARE_DIR)</NexusFirmwareDir>
    <_NexusFirmwareDir Condition="'$(NexusFirmwareDir)' != '' AND Exists('$(NexusFirmwareDir)')">$(NexusFirmwareDir)</_NexusFirmwareDir>
    <_NexusFirmwareDir Condition="'$(_NexusFirmwareDir)' == '' AND Exists('$(MSBuildThisFileDirectory)data\firmware')">$(MSBuildThisFileDirectory)data\firmware</_NexusFirmwareDir>
    <_NexusFirmwareDir Condition="'$(_NexusFirmwareDir)' == '' AND Exists('$(MSBuildThisFileDirectory)..\firmware')">$(MSBuildThisFileDirectory)..\firmware</_NexusFirmwareDir>
    <_NexusFirmwareDir Condition="'$(_NexusFirmwareDir)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\firmware')">$(MSBuildThisFileDirectory)..\..\firmware</_NexusFirmwareDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(_NexusFirmwareDir)' != ''">
    <EmbeddedResource Include="$(_NexusFirmwareDir)\**\*.hex">
      <LogicalName>firmware/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ReportFirmwareBundle" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(NexusFirmwareDir)' != '' AND !Exists('$(NexusFirmwareDir)')"
           Text="NexusFirmwareDir / NEXUS_FIRMWARE_DIR points at '$(NexusFirmwareDir)', which does not exist." />
    <Message Importance="normal" Condition="'$(_NexusFirmwareDir)' != ''" Text="Bundled firmware: embedding images from $(_NexusFirmwareDir)" />
    <Message Importance="high" Condition="'$(_NexusFirmwareDir)' == ''" Text="Bundled firmware: no image directory found; the firmware catalog will be empty (set NEXUS_FIRMWARE_DIR to embed images)" />
  </Target>

  <!-- A publish carrying the client token is one we ship, and it must not go
       out without the firmware it advertises. Checked before the build so an
       AOT compile is not wasted on a publish that cannot succeed. -->
  <Target Name="EnsureFirmwareBundle" BeforeTargets="BeforeBuild" Condition="'$(_IsPublishing)' == 'true' AND '$(NexusClientToken)' != ''">
    <Error Condition="'$(_NexusFirmwareDir)' == ''"
           Text="Official publish without bundled firmware images: none of NexusFirmwareDir / NEXUS_FIRMWARE_DIR ('$(NexusFirmwareDir)'), data/firmware, ../firmware, ../../firmware exists. Point NEXUS_FIRMWARE_DIR at the private firmware directory, or publish without a client token for a local-only build." />
  </Target>

  <!-- macOS status bar icons (template images that adapt to dark/light menu bar) -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx')) OR ('$(RuntimeIdentifier)' == '' AND $([MSBuild]::IsOSPlatform('OSX')))">
    <Content Include="Bundled\macos\status-icon.png">
      <Link>status-icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Bundled\macos\status-icon@2x.png">
      <Link>status-icon@2x.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- OpenRGB-headless binaries are NOT committed (see .gitignore) - they're
       built from sibling repo nexus-rgb/openrgb-headless and bundled into
       Bundled/{rid}/openrgb/. Fail Publish loudly if the bundle is missing,
       since silently skipping the <Content Include> below ships an app
       without RGB support. -->
  <!-- macOS ships AOT-only. We do not distribute non-AOT macOS builds because
       they drag in the full .NET runtime + managed DLLs and behave differently
       at runtime than what end users get. Fail the publish loudly if anyone
       overrides PublishAot=false for an osx-* RID. -->
  <Target Name="EnsureMacAot" BeforeTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <Error Condition="'$(PublishAot)' != 'true'"
           Text="macOS publish requires PublishAot=true. Non-AOT macOS builds are not shipped. Drop any -p:PublishAot=false override and re-run." />
  </Target>

  <!-- Both Apple linkers fail this link on an Xcode 26 toolchain: ld-prime
       asserts "too many large addends" (dotnet/runtime#119380, fixed only in
       .NET 11's object writer) and its ld_classic asserts in dylibToOrdinal.
       CI's runner toolchain still links fine with ld_classic, so that stays
       the default; a machine with Homebrew lld links with ld64.lld instead,
       and -p:NexusMacLdPath overrides the probe outright. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx')) AND '$(NexusMacLdPath)' == '' AND '$(GITHUB_ACTIONS)' != 'true'">
    <NexusMacLdPath Condition="Exists('/opt/homebrew/opt/lld/bin/ld64.lld')">/opt/homebrew/opt/lld/bin/ld64.lld</NexusMacLdPath>
    <NexusMacLdPath Condition="'$(NexusMacLdPath)' == '' AND Exists('/usr/local/opt/lld/bin/ld64.lld')">/usr/local/opt/lld/bin/ld64.lld</NexusMacLdPath>
  </PropertyGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx')) AND '$(NexusMacLdPath)' != ''">
    <LinkerArg Include="--ld-path=&quot;$(NexusMacLdPath)&quot;" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx')) AND '$(NexusMacLdPath)' == ''">
    <LinkerArg Include="-Wl,-ld_classic" />
  </ItemGroup>

  <!-- Same discipline for the shipped linux-x64 build: the CI nexus-linux job
       publishes -r linux-x64 with the project-default PublishAot=true. A JIT /
       framework-dependent Linux build drags in the .NET runtime and behaves
       differently than what ships, so fail a non-AOT linux-* publish loudly.
       RID-scoped, so a plain `dotnet build`/`dotnet test` (no RID) never trips it. -->
  <Target Name="EnsureLinuxAot" BeforeTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <Error Condition="'$(PublishAot)' != 'true'"
           Text="linux publish requires PublishAot=true. Non-AOT Linux builds are not shipped. Drop any -p:PublishAot=false override and re-run." />
  </Target>

  <!-- adb (Android platform-tools) is committed under Bundled/{rid}/adb/ and
       copied next to the service exe; AdbLocator resolves it first. Fail
       Publish if the per-RID bundle was deleted. -->
  <Target Name="EnsureAdbBundle" BeforeTargets="Publish">
    <Error Condition="$(RuntimeIdentifier.StartsWith('win')) AND !Exists('Bundled\win-x64\adb\adb.exe')"
           Text="adb bundle missing at Bundled\win-x64\adb\adb.exe. Restore from platform-tools-latest-windows.zip (adb.exe + AdbWinApi.dll + AdbWinUsbApi.dll + libwinpthread-1.dll + NOTICE.txt)." />
    <Error Condition="$(RuntimeIdentifier.StartsWith('osx')) AND !Exists('Bundled/osx-arm64/adb/adb')"
           Text="adb bundle missing at Bundled/osx-arm64/adb/adb. Restore from platform-tools-latest-darwin.zip: lipo -thin arm64 adb." />
    <Error Condition="$(RuntimeIdentifier.StartsWith('linux')) AND !Exists('Bundled/linux-x64/adb/adb')"
           Text="adb bundle missing at Bundled/linux-x64/adb/adb. Restore from platform-tools-latest-linux.zip." />
  </Target>

  <!-- Bench bundle: primesieve / clpeak / vkpeak / diskspd / stream.
       Windows-only; stream.exe is compiled on the host (see Bundled/win-x64/bench/stream/BUILD.md).
       Fails win Publish if any binary is missing; does not block macOS/Linux builds. -->
  <Target Name="EnsureBenchBundle" BeforeTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <Error Condition="!Exists('Bundled\win-x64\bench\primesieve\primesieve.exe')"
           Text="Bench bundle missing: Bundled\win-x64\bench\primesieve\primesieve.exe. Download from github.com/kimwalisch/primesieve releases (win-x64 zip)." />
    <Error Condition="!Exists('Bundled\win-x64\bench\clpeak\clpeak.exe')"
           Text="Bench bundle missing: Bundled\win-x64\bench\clpeak\clpeak.exe. Download from github.com/krrishnarraj/clpeak releases (windows x86_64 zip)." />
    <Error Condition="!Exists('Bundled\win-x64\bench\vkpeak\vkpeak.exe')"
           Text="Bench bundle missing: Bundled\win-x64\bench\vkpeak\vkpeak.exe. Download from github.com/nihui/vkpeak releases (windows zip)." />
