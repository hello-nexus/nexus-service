# .NET
bin/
obj/
# BenchmarkDotNet writes results here when the benchmark project is run.
BenchmarkDotNet.Artifacts/
# Catch every flavour of publish output (publish-aot, publish-mac,
# publish-mac-aot, publish-linux, publish-win, etc.) without having to
# enumerate every variant.
publish/
publish-*/
*.user
*.suo
.vs/

# macOS .app bundles produced by Bundled/macos/build-app.sh after publish.
*.app/

# Compiled OpenRGB-headless drops live in Bundled/{rid}/openrgb/ and are
# produced by nexus-rgb/bundle-macos.sh (or scripts/build-windows.bat on
# Windows) from the openrgb-headless submodule. Don't commit binaries.
# PawnIO under Bundled/win-x64/pawnio/ stays tracked - it's a signed kernel
# driver that can't be rebuilt without Microsoft attestation.
Bundled/*/openrgb/
# ffmpeg is vendored at Bundled/{rid}/ffmpeg/ but too large to commit
# (~96 MB on Windows). Fetched from gyan.dev/ffmpeg at setup time.
Bundled/*/ffmpeg/
# NexusVCam media source binary staged for the win publish; built out-of-band
# on the PC from Bundled/windows/nexus-vcam (CMake + VS Build Tools).
Bundled/win-x64/vcam/
# Chroma shim DLLs produced by nexus-gamesync build.bat/build32.bat. Build
# artifacts; .gitkeep placeholders keep the x64/ and x86/ dirs tracked.
Bundled/win-x64/chroma/**/*.dll

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Logs
*.log

# wwwroot is populated by `npm run build` in nexus-web; ignore the bundled artifact
# but keep the directory itself so the csproj <Content Include> doesn't error.
wwwroot/*
!wwwroot/.gitkeep
CHANGELOG.md
.deep-build/

# ffmpeg source + build intermediates produced by scripts/build-ffmpeg-minimal.sh
build/

# AOT publish output (regenerated; metadata leaks personal paths)
builds/

# VS/dotnet test result artifacts (regenerated; metadata leaks personal paths)
**/TestResults/

# Local dev worktree symlink for the bundled app payload, kept per-machine, never committed.
.worktrees/

# Vendor device firmware images are not part of this repository; the build
# embeds them from the private workspace (see the csproj). A local drop-in
# here is picked up the same way.
data/firmware/
